# ==============================================================================
# ROVERMIND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN CREDENTIALS ONLY WHEN READY FOR LIVE INFERENCE.
# THIS TEMPLATE DEFAULTS TO SAFE PRE-LIVE / OFFLINE SETTINGS TO PREVENT UNINTENDED
# PAID API REQUESTS, ACCIDENTAL RATE-LIMIT CONSUMPTION, OR SECRET LEAKAGE.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SECURITY & GLOBAL KILL SWITCHES (CRITICAL SAFETY CONTROLS)
# ------------------------------------------------------------------------------
# EXTERNAL_API_ENABLED:
#   Global master kill switch. When set to 'false', NO external HTTP network
#   requests are ever transmitted. The pipeline operates exclusively with
#   local synthetic segmentation fixtures and deterministic rule engines.
#   Default: false
EXTERNAL_API_ENABLED=false

# EXTERNAL_API_DRY_RUN:
#   When set to 'true', validates payloads, prompts, tokens, and schemas locally
#   without dispatching network calls to Meta servers.
#   Default: true
EXTERNAL_API_DRY_RUN=true


# ------------------------------------------------------------------------------
# 2. META AI CREDENTIALS (NEVER COMMIT REAL SECRETS TO GIT)
# ------------------------------------------------------------------------------
# Meta SAM 3.1 visual segmentation API key (from Meta AI Developer Portal)
META_API_KEY=your_meta_sam_api_key_here

# Meta Reasoning API key (defaults to META_API_KEY if left blank)
META_REASONING_API_KEY=your_meta_reasoning_api_key_here


# ------------------------------------------------------------------------------
# 3. REASONING PROVIDER & MODEL ROUTING
# ------------------------------------------------------------------------------
# REASONING_PROVIDER:
#   Preferred reasoning provider:
#     - 'muse-spark' : High-performance multimodal reasoning model (Primary)
#     - 'llama-3.3'  : Meta Llama 3.3 70B Instruct (Fallback)
#     - 'offline'    : 100% deterministic rule-based computation
#   Default: muse-spark
REASONING_PROVIDER=muse-spark

# MUSE_SPARK_MODEL:
#   Exact model identifier for Meta Muse Spark:
#     - 'muse-spark-1.3'             : Standard production release
#     - 'muse-spark-1.3-contributor' : Hackathon / Contributor tier access
#     - 'muse-spark-open'            : Open weights endpoint
#   Default: muse-spark-1.3
MUSE_SPARK_MODEL=muse-spark-1.3

# LLAMA_MODEL:
#   Exact fallback model identifier:
#   Default: llama-3.3-70b-instruct
LLAMA_MODEL=llama-3.3-70b-instruct

# FALLBACK_REASONING_PROVIDER:
#   Provider to automatically switch to if primary model returns 403 (unauthorized/allowlist) or 404
#   Default: llama-3.3
FALLBACK_REASONING_PROVIDER=llama-3.3

# Meta Reasoning Base URL (OpenAI-compatible Meta endpoint)
META_REASONING_BASE_URL=https://api.meta.ai/v1


# ------------------------------------------------------------------------------
# 4. HARD REQUEST & RATE BUDGET ENFORCEMENT
# ------------------------------------------------------------------------------
# Maximum SAM 3.1 visual concept segmentation queries per analysis run
MAX_SAM_REQUESTS_PER_ANALYSIS=1

# Maximum reasoning API queries per observation briefing generation (default: 2 to permit primary + fallback attempt)
MAX_REASONING_REQUESTS_PER_BRIEFING=2

# Maximum total reasoning API requests per operator chat turn (default: 3, allowing 1 initial + up to 2 tool loop calls)
# Note: MAX_REASONING_REQUESTS_PER_CHAT is the hard outer budget cap for the turn.
MAX_REASONING_REQUESTS_PER_CHAT=3

# Maximum iterative tool executions permitted per chat turn (loop limit, bounded by request budget)
MAX_TOOL_ITERATIONS_PER_CHAT=2

# Concurrency limits (simultaneous in-flight requests)
MAX_CONCURRENT_SAM_REQUESTS=1
MAX_CONCURRENT_REASONING_REQUESTS=1


# ------------------------------------------------------------------------------
# 5. INPUT BOUNDS, SIZING & TIMEOUT PROTECTION
# ------------------------------------------------------------------------------
# Maximum characters permitted in operator chat query
MAX_INPUT_TEXT_LENGTH=1000

# Maximum message turns preserved in in-memory conversation context
MAX_CONVERSATION_HISTORY_MESSAGES=10

# Maximum tool JSON payload size in bytes passed into reasoning context (prevents context blowout)
MAX_TOOL_OUTPUT_BYTES=8192

# HTTP Network Timeouts (in seconds)
CONNECT_TIMEOUT_SECONDS=5.0
READ_TIMEOUT_SECONDS=25.0

# Automatic Retries (Set to 0 to prevent runaway retry loops on rate limits or failures)
MAX_RETRIES=0
